# How to run this script: ./clean trending_videos_unclean.csv
# Summary: Checks the input CSV file before cleaning the trending videos data for CITS4407 Assignment 2

input_csv_file="$1"
expected_unclean_column_count=7

# Check that the user provided an input CSV file name
if [[ $# -eq 0 ]]
then
    echo "ERROR: No input CSV file provided"
    exit 1
fi

# Check that the input file exists in the current directory
if [[ ! -f "$input_csv_file" ]]
then
    echo "ERROR: Input file not found in the current directory"
    exit 1
fi

# Check that the input file has the expected CSV extension
case "$input_csv_file" in
    *.csv)
        ;;
    *)
        echo "ERROR: Input file expected in a CSV format"
        exit 1
        ;;
esac

# Check that the input CSV file contains data
if [[ ! -s "$input_csv_file" ]]
then
    echo "ERROR: Empty file provided"
    exit 1
fi

# Check that the header has the expected number of columns
if ! gawk -F',' -v expected_columns="$expected_unclean_column_count" '
    NR == 1 {
        if (NF != expected_columns) {
            exit 1
        }
        exit 0
    }
' "$input_csv_file"
then
    echo "ERROR: Expected 7 columns in the input"
    exit 1
fi

exit 0